{
  "extends": ["airbnb-base"],
  "env": {
    "browser": true,
    "es2021": true
  },
  "rules": {
    "import/prefer-default-export": "off",
    "console": "off",
    "import/extensions": [
      "error",
      "ignorePackages",
      {
        "js": "never",
        "jsx": "never"
      }
    ],
    "import/no-extraneous-dependencies": [
      "error",
      {
        "devDependencies": [
          "src/index.js",
          "src/setupTests.js",
          "**/*.test.js",
          "**/*.spec.js"
        ]
      }
    ],
    "no-new": "off"
  },
  "settings": {
    "import/resolver": {
      "node": {
        "extensions": [".js", ".jsx"]
      }
    }
  }
}
